# Path to your Firebase service account JSON (Admin SDK)
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Firebase Web API Key (Project Settings -> General -> Web API Key)
# Needed only for email/password login via REST (Admin SDK can't verify passwords)
FIREBASE_WEB_API_KEY=your_web_api_key_here

# Flask
FLASK_SECRET_KEY=change_this_to_something_random
FLASK_DEBUG=True
PORT=5000
